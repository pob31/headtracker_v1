/*
 * Head unit overlay — Seeed XIAO nRF52840 Sense.
 *
 * ESB owns interrupt priorities 0-1 (PRD risk #1); every other peripheral
 * must sit at >= 2 or the radio takes CRC errors under I/O load. The nRF52
 * devicetree default for TWIM is priority 1, so bump both TWIM instances
 * (the onboard LSM6DS3TR-C sits on one of them; raising the other is
 * harmless). Second interrupt cell is the priority.
 *
 * Verified from the generated DT: the lsm6ds3tr_c node lives on &i2c0
 * (TWIM0 @ 0x40003000, IRQ 3). &i2c1 is raised too — harmless, and covers
 * any future external-header I2C use. Still to check on hardware: radio CRC
 * error rate while streaming at 416 Hz (IRQ priority interaction).
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

&i2c0 {
	interrupts = <3 2>;
};

&i2c1 {
	interrupts = <4 2>;
};

/* The IMU rail is always-on, so the chip keeps state across MCU resets and
 * the lsm6dsl driver's boot-time init fails on any warm boot ("Failed to
 * initialize chip", Zephyr #55892 class). Defer the driver init; main()
 * SW_RESETs the chip over raw I2C first, then runs device_init() itself.
 * (A failed boot-time init cannot be retried: device_init() refuses
 * already-attempted devices.) */
&lsm6ds3tr_c {
	zephyr,deferred-init;
};
